  "CourseQuality": {
    "Enabled": false,
    "PrePublish": {
      "Enabled": false,
      "LinkTimeoutMilliseconds": 3000
    },
    "RubricVersion": "v5-visible-proof",
    "Criteria": {
      "ListingLive": { "Weight": 20, "HardGate": true },
      "LinkWorks": { "Weight": 20, "HardGate": true },
      "DatesAccurate": { "Weight": 30, "HardGate": true },
      "DataComplete": { "Weight": 15, "HardGate": false },
      "FormatIdentified": { "Weight": 15, "HardGate": false }
    },
    "VerifiedScoreThreshold": 80,
    "ReviewConfidenceThreshold": 0.7,
    "HardGateScoreCap": 49,
    "RuleOnlyConfidenceCap": 0.69,
    "InconclusiveLinkScore": 50,
    "InconclusiveLinkConfidencePenalty": 0.3,
    "AIHardGateFailScore": 50,
    "FormatUnknownScore": 20,
    "WebinarMaxCommitmentHours": 3,
    "CourseMinCommitmentHours": 168,
    "DatePlausibleYearsPast": 15,
    "DatePlausibleYearsFuture": 5,
    "BatchSize": 100,
    "Schedule": "0 * * * *",
    "ReassessIntervalInDays": 7,
    "CardMaxAgeInDays": 14,
    "RegradeDelayInSeconds": 30,
    "SourcePageReaderEnabled": true,
    "VerifyTypes": [ "Learning" ],
    "SelfPacedProviders": [
      {
        "Name": "Alison Learning",
        "Domains": [ "alison.com" ]
      }
    ],
    "LinkCheck": {
      "MaxRedirects": 5,
      "TimeoutInSeconds": 15,
      "MaxResponseBytes": 1048576,
      "MinHostIntervalInMilliseconds": 1100,
      "MaxSourceTextLength": 20000,
      "UserAgent": "YomaCourseQualityBot/1.0 (+https://yoma.world)"
    },
    "Grading": {
      "Version": "g2-verified-only",
      "Factors": {
        "LearnerFeedback": { "Weight": 20, "NeutralScore": 50, "Parameters": { "PriorResponses": 10, "PriorMean": 0.7 } },
        "SyllabusAvailable": { "Weight": 18, "NeutralScore": 0, "Parameters": { "CourseJsonLdPoints": 15, "JsonLdFieldsPoints": 15, "OutcomesPoints": 30, "ModulesPoints": 30, "PrerequisitesPoints": 10, "MinListItems": 3, "ListingTextFactor": 0.5 } },
        "ProviderReliability": { "Weight": 15, "NeutralScore": 50, "Parameters": { "PassRateShare": 40, "DeadLinkShare": 20, "LearnerShare": 33.33, "ListingCountShare": 6.67, "PriorPasses": 8, "PriorChecks": 10, "ListingCountCap": 20 } },
        "Comprehensiveness": { "Weight": 12, "NeutralScore": 50, "Parameters": { "ModulesShare": 30, "ModulesCap": 15, "AssessmentShare": 15, "CertificateShare": 15, "SkillsShare": 20, "SkillsCap": 5, "DescriptionShare": 20, "DescriptionCap": 1500 } },
        "CourseLength": { "Weight": 10, "NeutralScore": 50, "Parameters": { "StudyHoursPerDay": 2, "StudyHoursPerWeek": 5, "StudyHoursPerMonth": 20, "ShortHours": 0.5, "IdealFromHours": 2, "IdealToHours": 20, "LongHours": 60, "VeryLongHours": 100, "ShortScore": 40, "LongScore": 60, "VeryLongScore": 40 } },
        "Completion": { "Weight": 10, "NeutralScore": 50, "Parameters": { "PriorStarts": 20 } },
        "ListingIntegrity": { "Weight": 8, "NeutralScore": 50, "Parameters": { "StatusShare": 40, "ConfidenceShare": 20, "LinkShare": 25, "AgeShare": 15, "MaxAgeYears": 3 } },
        "Accessibility": { "Weight": 7, "NeutralScore": 20, "Parameters": { "FreeScore": 40, "FreePaidCertificateScore": 25, "PaidScore": 0, "UnknownCostScore": 20, "LanguageBonus": 30, "LowDataBonus": 30 } },
        "Outcomes": { "Weight": 0, "NeutralScore": 50, "Parameters": { "MinGroupSize": 20, "ProgressionShare": 60, "EmploymentShare": 40, "ProgressionTarget": 0.5, "EmploymentTarget": 0.2 } }
      },
      "Bands": [
        { "Grade": "A", "Label": "Top pick", "TopPercent": 17, "MinScore": 65 },
        { "Grade": "B", "Label": "Strong", "TopPercent": 40, "MinScore": 0 },
        { "Grade": "C", "Label": "Good", "TopPercent": 75, "MinScore": 0 },
        { "Grade": "D", "Label": "Basic", "TopPercent": 100, "MinScore": 0 }
      ],
      "NeedsReviewMaxGrade": "Ungraded",
      "AMinSyllabusScore": 50,
      "AMinFeedbackScore": 60,
      "AFeedbackFloorMinResponses": 5,
      "MinFactorsWithData": 3
    },
    "LearnerFeedback": {
      "Enabled": false,
      "PromptDelayInMinutes": 1440,
      "SnoozeInDays": 3,
      "CommentMaxLength": 500,
      "Good": [
        { "Key": "clearExplanations", "Label": "Clear explanations" },
        { "Key": "practicalSkills", "Label": "Practical skills I can use" },
        { "Key": "goodLength", "Label": "Good length" },
        { "Key": "usefulCertificate", "Label": "Useful certificate" },
        { "Key": "workedOnPhone", "Label": "Worked well on my phone" }
      ],
      "Bad": [
        { "Key": "tooLong", "Label": "Too long" },
        { "Key": "tooHard", "Label": "Too hard" },
        { "Key": "linkProblems", "Label": "Link or page problems" },
        { "Key": "notAsDescribed", "Label": "Not as described" },
        { "Key": "hiddenCosts", "Label": "Hidden costs" },
        { "Key": "tooMuchData", "Label": "Used too much data" },
        { "Key": "outdated", "Label": "Outdated" }
      ]
    }
  },

