       <div class="chips" style="margin-top:10px">${[...held()].map(k => `<span class="chip have">${esc(SK[k])}</span>`).join('')}</div>` : '<p class="empty-note">No credentials on this profile yet.</p>')
-      : `<p class="empty-note">${S.consent === false ? 'The user chose not to share. Pathfinder plans from their answers only.' : `Sample profile for ${esc(P.name)}: ${P.creds.length} credential${P.creds.length === 1 ? '' : 's'}. Pathfinder asks before reading it.`}</p>`}
+      : `<p class="empty-note">${S.consent === false ? 'The user chose not to share. Pathfinder plans from their answers only.' : `Sample profile for ${esc(P.full || P.name)}: ${P.creds.length} credential${P.creds.length === 1 ? '' : 's'}. Pathfinder asks before reading it.`}</p>`}
     <p class="empty-note" style="margin-top:10px"><b>Skills Backpack (YoID)</b>: ${S.backpack === true ? 'activated' : S.backpack === false ? (S.age !== null && S.age < 16 ? 'not offered (YoID starts at 16)' : 'declined, nothing written') : `not asked yet${S.yoidQueue && S.yoidQueue.length ? ` · ${S.yoidQueue.length} record waiting for consent` : ''}`}</p>
     ${S.yoid && S.yoid.length ? `<p class="empty-note" style="margin-top:10px"><b>YoID records</b> (mocked writes for the prototype):</p>
