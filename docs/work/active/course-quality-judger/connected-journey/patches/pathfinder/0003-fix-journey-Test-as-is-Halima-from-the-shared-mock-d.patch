+// In the journey, "Test as" is Halima from the shared mock data, not Amina: her name, and the credentials she already
+// holds when the plan is made (issued before the Learning Plan, not self-declared; the course and SkillLens ones come later).
+function journeyPersona(d){
+  const yp = d.youngPerson, org = id => (d.partners.find(p => p.id === id) || {}).name || id;
+  const before = (d.learningPlan && d.learningPlan.createdOn) || '9999-12-31';
+  PERSONAS.halima = {name: yp.firstName, full: `${yp.firstName} ${yp.lastName}`,
+    creds: (d.credentials || []).filter(c => c.issuer !== 'self' && c.issuedOn && c.issuedOn < before)
+      .map(c => ({title: c.title, src: org(c.issuer), skills: c.skills || []}))};
+  persona = 'halima';
+  const state = yp.state ? yp.state[0].toUpperCase() + yp.state.slice(1) : '';
+  const work = (yp.informalSkills || [])[0] === 'phone-repair' ? 'phone repair' : '';
+  const sub = document.getElementById('halima-sub'); if (sub) sub.textContent = [yp.age, state, work].filter(Boolean).join(' · ');
+  document.querySelectorAll('#persona button').forEach(b => { if (b.dataset.v === 'halima') b.hidden = false; b.setAttribute('aria-pressed', b.dataset.v === 'halima'); });
+}
