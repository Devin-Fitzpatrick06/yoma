# Course Quality demo only. Every value here is a local placeholder or a public default
# already in src/api/docker-compose.yml. Never put a real secret in this file.

# API
ASPNETCORE_ENVIRONMENT=Local
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__SQLConnection=Host=postgres;Port=5432;Database=yoma-dev;Username=postgres;Password=P@ssword1;SslMode=Prefer;Trust Server Certificate=True;Include Error Detail=true;GSS Encryption Mode=Disable;
ConnectionStrings__RedisConnection=valkey:6379
Keycloak__AuthServerUrl=http://localhost:8080
AllowedOrigins=http://localhost:3000;http://localhost:5050
Logging__LogLevel__Default=Information

# Turns the assessment on for this demo only. appsettings.json keeps it off.
CourseQuality__Enabled=true

# Lets the Alison stand-in page qualify as self-paced when the real page is unavailable.
CourseQuality__SelfPacedProviders__0__Domains__1=demo-fixtures.localtest.me

# Listing checks (live, link works, real dates, enough data) for Event and Job opportunities too, not grading. Index 0 is
# Learning, from appsettings.json. Events and jobs are assessed on demand (POST courseQuality/opportunity/{id}/assess), since
# the demo runs no background batch, and their results show in the review queue and the partner's fix notes only.
CourseQuality__VerifyTypes__1=Event
CourseQuality__VerifyTypes__2=Job

# Shows each course's status in browse and lists verified courses first.
CourseQuality__ShowInBrowse=true

# The product's polite pace: 1.1 s between requests to one host, also for the live catalogue run.
CourseQuality__LinkCheck__MinHostIntervalInMilliseconds=1100

# The demo assesses on start, not on the hourly schedule, so the background job takes no courses. Results stay current
# however old the saved snapshot is, so a demo started weeks later still shows its badges.
CourseQuality__BatchSize=0
CourseQuality__ReassessIntervalInDays=3650
CourseQuality__CardMaxAgeInDays=3650

# "Did you take it?" feedback, asked one minute after a learner leaves for a course instead of one day.
CourseQuality__LearnerFeedback__Enabled=true
CourseQuality__LearnerFeedback__PromptDelayInMinutes=1

# Web
NEXTAUTH_URL=http://localhost:3000
KEYCLOAK_ISSUER=http://localhost:8080/realms/yoma
KEYCLOAK_CLIENT_ID=yoma-web
KEYCLOAK_CLIENT_SECRET=superSecretYomaWebClientSecret
NEXT_PUBLIC_KEYCLOAK_DEFAULT_PROVIDER=yoma-web
API_BASE_URL=http://localhost:5000/api/v3
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050/api/v3
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=local-demo-placeholder
NEXT_PUBLIC_GA_MEASUREMENT_ID=local-demo-placeholder
MARKETPLACE_ENABLED=true
NEXT_PUBLIC_PASSPORT_ENABLED=true
NEXT_PUBLIC_REFERRALS_ENABLED=true
# The demo view switcher. Build-time values: docker-compose.demo.yml passes these to the web build, and these copies
# serve the server side.
NEXT_PUBLIC_COURSE_QUALITY_DEMO=true
NEXT_PUBLIC_COURSE_QUALITY_DEMO_ORG_ID=c0a7e000-0000-4000-8000-000000000001

# My Yoma outcomes come from the synthetic demo learners, so every outcome note says so.
Pathway__DemoDataNote=Demo data: these figures come from synthetic demo learners, not real youth.
