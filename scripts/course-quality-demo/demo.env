# Course Quality demo only. Every value here is a local placeholder or a public default
# already in src/api/docker-compose.yml. Never put a real secret in this file.

# API
ASPNETCORE_ENVIRONMENT=Local
ASPNETCORE_URLS=http://+:5000
ConnectionStrings__SQLConnection=Host=postgres;Port=5432;Database=yoma-dev;Username=postgres;Password=P@ssword1;SslMode=Prefer;Trust Server Certificate=True;Include Error Detail=true;GSS Encryption Mode=Disable;
ConnectionStrings__RedisConnection=valkey:6379
Keycloak__AuthServerUrl=http://localhost:8080
AllowedOrigins=http://localhost:3000;http://localhost:5050
Logging__LogLevel__Default=Information

# Turns the assessment on for this demo only. appsettings.json keeps it off.
CourseQuality__Enabled=true

# Lets the Alison stand-in page qualify as self-paced when the real page is unavailable.
CourseQuality__SelfPacedProviders__0__Domains__1=demo-fixtures.localtest.me

# Web
NEXTAUTH_URL=http://localhost:3000
KEYCLOAK_ISSUER=http://localhost:8080/realms/yoma
KEYCLOAK_CLIENT_ID=yoma-web
KEYCLOAK_CLIENT_SECRET=superSecretYomaWebClientSecret
NEXT_PUBLIC_KEYCLOAK_DEFAULT_PROVIDER=yoma-web
API_BASE_URL=http://localhost:5000/api/v3
NEXT_PUBLIC_API_BASE_URL=http://localhost:5050/api/v3
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=local-demo-placeholder
NEXT_PUBLIC_GA_MEASUREMENT_ID=local-demo-placeholder
MARKETPLACE_ENABLED=true
NEXT_PUBLIC_PASSPORT_ENABLED=true
NEXT_PUBLIC_REFERRALS_ENABLED=true
